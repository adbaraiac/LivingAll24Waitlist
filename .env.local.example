# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` (it is gitignored). NEVER hardcode secrets in code.
# Only NEXT_PUBLIC_* values are exposed to the browser — that is expected here,
# because the waitlist endpoint is a public POST URL protected on the AWS side.
# -----------------------------------------------------------------------------

# The public URL of your AWS API Gateway endpoint that receives waitlist signups.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod/waitlist
# Leave blank during design/preview — the form will run in "demo mode" and still
# show the full success flow without sending anything.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Base path for GitHub Pages project sites (e.g. "/arc-waitlist").
# Leave blank for a custom domain or a <user>.github.io root site.
NEXT_PUBLIC_BASE_PATH=
